rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Relational Check: Checks if the logged in user is part of the specified coupleCode
    function isCoupleMember(coupleCode) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleCode == coupleCode;
    }

    // SCHEMA VALIDATION BLUEPRINTS

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'joinedAt']) &&
        data.keys().size() <= 6 &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role in ['husband', 'wife'] &&
        (data.coupleCode == null || (data.coupleCode is string && data.coupleCode.size() <= 50)) &&
        (data.partnerUid == null || (data.partnerUid is string && data.partnerUid.size() <= 128));
    }

    function isValidMoneyActivity(data) {
      return data.keys().hasAll(['id', 'amount', 'type', 'category', 'date', 'scope', 'by', 'createdAt', 'coupleCode']) &&
        data.keys().size() <= 11 &&
        data.id is string && data.id.size() <= 128 &&
        data.amount is number && data.amount >= 0 &&
        data.type in ['in', 'out'] &&
        data.category in ['Food', 'Transport', 'Shopping', 'Rent', 'Internet', 'Entertainment', 'Gifts', 'Bills', 'Healthcare', 'Emergency', 'Other'] &&
        data.scope in ['personal', 'shared'] &&
        data.by in ['husband', 'wife'] &&
        data.coupleCode is string && data.coupleCode.size() <= 50 &&
        (data.notes == null || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidDreamGoal(data) {
      return data.keys().hasAll(['id', 'title', 'targetAmount', 'savedAmount', 'deadline', 'createdAt', 'isCompleted', 'coupleCode']) &&
        data.keys().size() <= 9 &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 100 &&
        data.targetAmount is number && data.targetAmount >= 0 &&
        data.savedAmount is number && data.savedAmount >= 0 &&
        data.isCompleted is bool &&
        data.coupleCode is string && data.coupleCode.size() <= 50;
    }

    function isValidSpendingPlan(data) {
      return data.keys().hasAll(['id', 'coupleCode', 'monthYyyy', 'limits']) &&
        data.keys().size() <= 5 &&
        data.id is string && data.id.size() <= 128 &&
        data.coupleCode is string && data.coupleCode.size() <= 50 &&
        data.monthYyyy is string && data.monthYyyy.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.limits is map;
    }

    // MATCH RULES

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && 
                      isValidUserProfile(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid;
      allow delete: if false; // Profiles are immortal
    }

    // Couples Space collections nested under coupleCode
    match /couples/{coupleCode} {
      // General match for paths in couples space
      
      match /activities/{activityId} {
        allow list, get: if isCoupleMember(coupleCode);
        allow create: if isCoupleMember(coupleCode) && 
                        isValidId(activityId) && 
                        isValidMoneyActivity(request.resource.data) &&
                        request.resource.data.coupleCode == coupleCode;
        allow update: if isCoupleMember(coupleCode) && 
                        isValidId(activityId) && 
                        isValidMoneyActivity(request.resource.data) &&
                        request.resource.data.coupleCode == coupleCode &&
                        request.resource.data.id == resource.data.id;
        allow delete: if isCoupleMember(coupleCode);
      }

      match /goals/{goalId} {
        allow list, get: if isCoupleMember(coupleCode);
        allow create: if isCoupleMember(coupleCode) && 
                        isValidId(goalId) && 
                        isValidDreamGoal(request.resource.data) &&
                        request.resource.data.coupleCode == coupleCode;
        allow update: if isCoupleMember(coupleCode) && 
                        isValidId(goalId) && 
                        isValidDreamGoal(request.resource.data) &&
                        request.resource.data.coupleCode == coupleCode &&
                        request.resource.data.id == resource.data.id;
        allow delete: if isCoupleMember(coupleCode);
      }

      match /spendingPlans/{planId} {
        allow list, get: if isCoupleMember(coupleCode);
        allow create: if isCoupleMember(coupleCode) && 
                        isValidId(planId) && 
                        isValidSpendingPlan(request.resource.data) &&
                        request.resource.data.coupleCode == coupleCode;
        allow update: if isCoupleMember(coupleCode) && 
                        isValidId(planId) && 
                        isValidSpendingPlan(request.resource.data) &&
                        request.resource.data.coupleCode == coupleCode &&
                        request.resource.data.id == resource.data.id;
        allow delete: if isCoupleMember(coupleCode);
      }
    }
  }
}
